APP_NAME="Seal Online Boss Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# =============================================================
# Database Configuration (MySQL)
# =============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seal_tracker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# =============================================================
# Node.js Multi-Tenant Daemon & WebSocket Configuration
# =============================================================
WEBSOCKET_PORT=3001
LARAVEL_API_URL=http://127.0.0.1:8000
DAEMON_INTERNAL_SECRET=seal_internal_secret_random_64_characters_here

# Default Discord Token (digunakan saat buat server baru jika token dikosongkan)
DISCORD_TOKEN=your_discord_bot_token_here
DEFAULT_DISCORD_TOKEN=your_discord_bot_token_here

# =============================================================
# Cloudflare Turnstile (Anti-Bot / CAPTCHA Protection)
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Testing Keys:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# =============================================================
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
